---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/jetbrains-mono";
import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";

import LinkTooltip from "../components/LinkTooltip.astro";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "Zachary Davison",
    description = "~",
    ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://www.zac.ooo");
const microlinkURL = new URL("https://api.microlink.io/");
microlinkURL.searchParams.set("url", canonicalURL.href);
microlinkURL.searchParams.set("screenshot", "true");
microlinkURL.searchParams.set("meta", "false");
microlinkURL.searchParams.set("embed", "screenshot.url");
microlinkURL.searchParams.set("viewport.width", "1200");
microlinkURL.searchParams.set("viewport.height", "630");
const screenshotURL = ogImage ?? microlinkURL.href;
---

<!doctype html>
<html lang="gl">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={screenshotURL} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={screenshotURL} />

        <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
        <title>{title}</title>
        <script is:inline>
            document.documentElement.setAttribute("data-theme", "lofi");
        </script>
    </head>
    <body class="min-h-screen">
        <slot />
        <LinkTooltip />
    </body>
</html>

<style is:global>
    html,
    body {
        overflow-x: hidden;
    }

    body {
        font-family: "DM Sans Variable", sans-serif;
    }

    @media (min-width: 768px) {
        .container {
            display: flex;
            flex-wrap: wrap;
        }
    }

    @media only screen and (max-width: 480px) {
        * {
            font-size: 12px;
        }
    }

    .overflow-y-scroll::-webkit-scrollbar {
        width: 3px;
    }

    .overflow-y-scroll::-webkit-scrollbar-thumb {
        background-color: oklch(var(--s));
    }

    .overflow-y-scroll {
        scrollbar-width: 1px;
    }

    @media (max-width: 768px) {
        .container {
            flex-direction: column;
        }
    }

    @media (min-width: 768px) {
        .container {
            display: flex;
            flex-wrap: wrap;
        }
    }

    /* Print styles */
    @media print {
        body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            min-height: auto !important;
        }

        .print\:hidden {
            display: none !important;
        }

        .card {
            box-shadow: none !important;
            page-break-inside: avoid;
        }

        .hatch-shadow::after {
            display: none !important;
        }

        .section-container {
            page-break-inside: avoid;
        }
    }

    .prose code {
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
        background-color: oklch(var(--bc2) / 0.05);
        padding: 0.15em 0.35em;
        border-radius: 0.25rem;
        font-size: 0.85em;
    }

    .prose pre {
        border: 1px solid oklch(var(--bc) / 0.1);
        border-radius: 0.25rem;
        background-color: oklch(var(--bc2) / 0.05) !important;
    }

    .prose pre code {
        background-color: transparent;
        padding: 0;
        border-radius: 0;
        font-size: inherit;
    }

    /* Custom prose styles to preserve multiple newlines and whitespace */
    .prose p:empty {
        height: 1em;
        margin: 0.5em 0;
        display: block;
    }

    .prose p + p {
        margin-top: 1em;
    }

    /* Preserve spacing for consecutive empty paragraphs */
    .prose p:empty + p:empty {
        height: 1em;
        margin-top: 0.5em;
    }

    /* Handle paragraphs containing only &nbsp; */
    .prose p:has(br:only-child),
    .prose p:has(span:only-child),
    .prose p[data-empty="true"] {
        height: 1em;
        margin: 0.5em 0;
        display: block;
    }

    /* Ensure non-breaking spaces render with proper spacing */
    .prose p {
        white-space: pre-wrap;
        line-height: 1.6;
        font-size: 0.85rem;
    }

    /* Apply font size to all prose elements */
    .prose,
    .prose p,
    .prose li,
    .prose ul,
    .prose ol {
        font-size: 0.85rem;
    }

    /* Comic book hatch shadow */
    .hatch-shadow {
        position: relative;
    }

    .hatch-shadow::after {
        content: "";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: repeating-linear-gradient(
            45deg,
            oklch(var(--s)) 0px,
            oklch(var(--s)) 1px,
            transparent 1px,
            transparent 4px
        );
        border-radius: inherit;
        pointer-events: none;
        opacity: 0.3;
        transition: top 0.15s ease, left 0.15s ease, opacity 0.15s ease;
    }

    .hatch-shadow:hover::after {
        top: 6px;
        left: 6px;
    }

    /* Link tooltip */
    .link-tooltip {
        position: absolute;
        top: 0;
        left: 0;
        padding: 0.35rem 0.6rem;
        font-size: 0.75rem;
        line-height: 1.4;
        max-width: 380px;
        background: oklch(var(--b1));
        color: oklch(var(--bc));
        border: 1px solid oklch(var(--bc) / 0.15);
        border-radius: 0.25rem;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.15s ease;
        z-index: 50;
        box-shadow: 0 2px 8px oklch(var(--bc) / 0.08);
    }

    .link-tooltip::after {
        content: "";
        position: absolute;
        width: 10px;
        height: 10px;
        background: oklch(var(--b1));
        rotate: 45deg;
    }

    /* Arrow pointing down (tooltip above element) */
    .link-tooltip.tooltip-above::after {
        bottom: -6px;
        left: var(--arrow-left, 50%);
        transform: translateX(-50%);
        border-right: 1px solid oklch(var(--bc) / 0.15);
        border-bottom: 1px solid oklch(var(--bc) / 0.15);
    }

    /* Arrow pointing right (tooltip in left margin) */
    .link-tooltip.tooltip-left::after {
        right: -6px;
        top: var(--arrow-top, 50%);
        transform: translateY(-50%);
        border-top: 1px solid oklch(var(--bc) / 0.15);
        border-right: 1px solid oklch(var(--bc) / 0.15);
    }

    .link-tooltip.visible {
        opacity: 1;
    }

    /* Highlight the hovered tooltip source */
    .tooltip-active {
        background: oklch(var(--s) / 0.15);
        border-radius: 0.15rem;
    }

    .link-tooltip-img {
        display: block;
        width: 360px;
        aspect-ratio: 1200 / 630;
        max-height: 200px;
        object-fit: cover;
        object-position: top;
        border-radius: 0.2rem;
        margin: 0.25rem 0;
        background: oklch(var(--bc) / 0.05);
        image-rendering: high-quality;
    }

    .link-tooltip:has(.link-preview) {
        max-width: 400px;
    }

    .link-preview {
        min-width: 200px;
    }

    .link-preview-loading {
        color: oklch(var(--bc) / 0.4);
        font-style: italic;
        padding: 0.25rem 0;
    }

    .link-preview-img {
        display: block;
        width: 100%;
        aspect-ratio: 1200 / 630;
        max-height: 180px;
        object-fit: cover;
        object-position: top;
        border-radius: 0.2rem;
        margin-bottom: 0.35rem;
        background: oklch(var(--bc) / 0.05);
        image-rendering: high-quality;
    }

    .link-preview-text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .link-preview-title {
        font-weight: 600;
        font-size: 0.75rem;
        line-height: 1.3;
        color: oklch(var(--bc));
    }

    .link-preview-desc {
        font-size: 0.7rem;
        line-height: 1.4;
        color: oklch(var(--bc) / 0.6);
    }

    .link-preview-domain {
        font-size: 0.65rem;
        color: oklch(var(--bc) / 0.35);
        margin-top: 0.1rem;
    }

</style>
