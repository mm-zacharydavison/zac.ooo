---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import { Icon } from "astro-icon/components";
import * as about from "../content/about/about.md";

const title = `${about.frontmatter.name} - CV`;
---

<BaseLayout title={title}>
  <Header />
  <div
    class="flex items-center absolute top-14 right-4 md:top-6 md:right-6 lg:top-8 lg:right-8 xl:top-10 xl:right-10 z-10 print:hidden"
  >
    <Icon name="carbon:moon" class="w-4 h-4" />
    <input
      type="checkbox"
      data-toggle-theme="black,lofi"
      data-act-class="ACTIVECLASS"
      class="toggle toggle-sm mx-1 bg-secondary"
      checked
      aria-label="Toggle theme"
    />
    <Icon name="carbon:light" class="w-4 h-4" />
  </div>

  <Nav />

  <main class="mx-auto flex-grow max-w-3xl py-2 grid w-[95vw]">
    <div class="container">
      <Container />
    </div>
  </main>
</BaseLayout>
