---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Nav from "../components/Nav.astro";
import ContactCard from "../components/ContactCard.astro";

import * as about from "../content/about/about.md";

const title = `${about.frontmatter.name} - ${about.frontmatter.designation}`;

type MarkdownInstance = {
  frontmatter: { title: string; url?: string; icon?: string; label?: string };
  compiledContent: () => string;
};

const contact = Object.values(
  import.meta.glob("../content/contact/*.md", { eager: true })
) as MarkdownInstance[];
---

<BaseLayout title={title}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <Nav />

    <main class="mx-auto max-w-3xl py-6 w-[95vw]">
      <article class="prose text-justify max-w-none text-base-content/60">
        <Fragment set:html={about.compiledContent()} />
      </article>
    </main>

    <footer class="mt-auto pb-8">
      <div class="flex flex-wrap gap-4 justify-center">
        {contact.map((item) => (
          <ContactCard
            url={item.frontmatter.url}
            label={item.frontmatter.label}
            icon={item.frontmatter.icon}
          />
        ))}
      </div>
    </footer>
  </div>
</BaseLayout>
