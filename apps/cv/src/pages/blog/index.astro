---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";
import { Icon } from "astro-icon/components";
import * as about from "../../content/about/about.md";

const title = `${about.frontmatter.name} - Blog`;

type BlogPost = {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
  };
  compiledContent: () => string;
};

const postModules = import.meta.glob("../../content/blogs/*.md", { eager: true }) as Record<string, BlogPost>;

const posts = Object.entries(postModules).map(([path, mod]) => ({
  slug: path.split("/").pop()!.replace(/\.md$/, ""),
  ...mod,
}));

const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout title={title}>
  <Header />
  <div
    class="flex items-center absolute top-4 right-4 md:top-6 md:right-6 lg:top-8 lg:right-8 xl:top-10 xl:right-10 z-10 print:hidden"
  >
    <Icon name="carbon:moon" class="w-4 h-4" />
    <input
      type="checkbox"
      data-toggle-theme="black,lofi"
      data-act-class="ACTIVECLASS"
      class="toggle toggle-sm mx-1 bg-secondary"
      checked
      aria-label="Toggle theme"
    />
    <Icon name="carbon:light" class="w-4 h-4" />
  </div>

  <Nav />

  <main class="mx-auto flex-grow max-w-3xl py-6 w-[95vw]">
    {sortedPosts.length === 0 && (
      <p class="text-secondary text-center py-8">No posts yet.</p>
    )}
    <div class="space-y-6">
      {sortedPosts.map((post) => (
        <a href={`/blog/${post.slug}`} class="block group">
          <article class="card card-compact card-bordered border border-[oklch(var(--s)/0.3)] hover:border-[oklch(var(--s))] transition-all hatch-shadow bg-base-100">
            <div class="card-body">
              <h2 class="card-title font-extrabold tracking-tight group-hover:underline">
                {post.frontmatter.title}
              </h2>
              <time class="text-sm text-secondary font-mono">
                {new Date(post.frontmatter.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {post.frontmatter.description && (
                <p class="text-secondary mt-2">{post.frontmatter.description}</p>
              )}
              {post.frontmatter.tags && (
                <div class="flex flex-wrap gap-2 mt-2">
                  {post.frontmatter.tags.map((tag) => (
                    <span class="badge badge-outline text-sm shadow-[1px_1px_0px_oklch(var(--s))]">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
