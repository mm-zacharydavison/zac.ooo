---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";
import { Icon } from "astro-icon/components";
import * as about from "../../content/about/about.md";

type BlogPost = {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
  };
  Content: astroHTML.JSX.Element;
  compiledContent?: () => string;
};

const postModules = import.meta.glob("../../content/blogs/*.{md,mdx}", { eager: true }) as Record<string, BlogPost>;

const posts = Object.entries(postModules).map(([path, mod]) => ({
  slug: path.split("/").pop()!.replace(/\.mdx?$/, ""),
  ...mod,
}));

function renderInlineCode(text: string) {
  return text.replace(/`([^`]+)`/g, '<code>$1</code>');
}

const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/blog");
}

const title = `${post.frontmatter.title} - ${about.frontmatter.name}`;
---

<BaseLayout title={title} description={post.frontmatter.description}>
  <Header />
<Nav />

  <main class="mx-auto flex-grow max-w-3xl pt-6 pb-[25vh] w-[95vw]">
    <article>
      <h1 class="text-3xl font-extrabold tracking-tight mb-2" set:html={renderInlineCode(post.frontmatter.title)} />
      <time class="text-sm text-secondary font-mono">
        {new Date(post.frontmatter.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.frontmatter.tags && (
        <div class="flex flex-wrap gap-2 mt-3">
          {post.frontmatter.tags.map((tag) => (
            <span class="badge badge-outline text-sm shadow-[1px_1px_0px_oklch(var(--s))]">{tag}</span>
          ))}
        </div>
      )}

      <div class="divider"></div>

      <div class="prose max-w-none blog-prose">
        <post.Content />
      </div>
    </article>
  </main>
</BaseLayout>

<script>
  function applyLinkPreviews() {
    document.querySelectorAll<HTMLAnchorElement>(".blog-prose a[href]").forEach((a) => {
      if (a.hasAttribute("data-tooltip")) return;
      const href = a.getAttribute("href") ?? "";
      if (!/^https?:\/\//i.test(href)) return;
      a.setAttribute("data-tooltip", `@[](${href})`);
    });
  }

  document.addEventListener("astro:page-load", applyLinkPreviews);
  if (document.readyState !== "loading") {
    applyLinkPreviews();
  } else {
    document.addEventListener("DOMContentLoaded", applyLinkPreviews);
  }
</script>
