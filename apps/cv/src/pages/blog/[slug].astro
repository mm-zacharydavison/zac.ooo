---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Nav from "../../components/Nav.astro";
import { Icon } from "astro-icon/components";
import * as about from "../../content/about/about.md";

type BlogPost = {
  frontmatter: {
    title: string;
    date: string;
    description?: string;
    tags?: string[];
  };
  compiledContent: () => string;
};

const postModules = import.meta.glob("../../content/blogs/*.md", { eager: true }) as Record<string, BlogPost>;

const posts = Object.entries(postModules).map(([path, mod]) => ({
  slug: path.split("/").pop()!.replace(/\.md$/, ""),
  ...mod,
}));

const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect("/blog");
}

const title = `${post.frontmatter.title} - ${about.frontmatter.name}`;
---

<BaseLayout title={title} description={post.frontmatter.description}>
  <Header />
  <div
    class="flex items-center absolute top-4 right-4 md:top-6 md:right-6 lg:top-8 lg:right-8 xl:top-10 xl:right-10 z-10 print:hidden"
  >
    <Icon name="carbon:moon" class="w-4 h-4" />
    <input
      type="checkbox"
      data-toggle-theme="black,lofi"
      data-act-class="ACTIVECLASS"
      class="toggle toggle-sm mx-1 bg-secondary"
      checked
      aria-label="Toggle theme"
    />
    <Icon name="carbon:light" class="w-4 h-4" />
  </div>

  <Nav />

  <main class="mx-auto flex-grow max-w-3xl py-6 w-[95vw]">
    <a href="/blog" class="text-sm text-secondary hover:underline mb-4 inline-flex items-center gap-1">
      <Icon name="carbon:arrow-left" class="w-4 h-4" />
      Back to blog
    </a>

    <article class="mt-4">
      <h1 class="text-3xl font-extrabold tracking-tight mb-2">
        {post.frontmatter.title}
      </h1>
      <time class="text-sm text-secondary font-mono">
        {new Date(post.frontmatter.date).toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.frontmatter.tags && (
        <div class="flex flex-wrap gap-2 mt-3">
          {post.frontmatter.tags.map((tag) => (
            <span class="badge badge-outline text-sm shadow-[1px_1px_0px_oklch(var(--s))]">{tag}</span>
          ))}
        </div>
      )}

      <div class="divider"></div>

      <div class="prose max-w-none">
        <Fragment set:html={post.compiledContent()} />
      </div>
    </article>
  </main>
</BaseLayout>
